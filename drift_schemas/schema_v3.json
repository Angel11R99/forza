  "fixed_sql": [
    {
      "name": "training_plans",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"training_plans\" (\"id\" TEXT NOT NULL, \"goal\" TEXT NOT NULL, \"experience\" TEXT NOT NULL, \"session_minutes\" INTEGER NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"is_active\" INTEGER NOT NULL DEFAULT 1 CHECK (\"is_active\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "training_plan_days",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"training_plan_days\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"plan_id\" TEXT NOT NULL REFERENCES training_plans (id) ON DELETE CASCADE, \"weekday\" INTEGER NOT NULL, \"order_index\" INTEGER NOT NULL, UNIQUE (\"plan_id\", \"weekday\"));"
        }
      ]
    },
    {
      "name": "training_plan_equipment",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"training_plan_equipment\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"plan_id\" TEXT NOT NULL REFERENCES training_plans (id) ON DELETE CASCADE, \"equipment\" TEXT NOT NULL, UNIQUE (\"plan_id\", \"equipment\"));"
        }
      ]
    },
    {
      "name": "workout_sessions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"workout_sessions\" (\"id\" TEXT NOT NULL, \"plan_id\" TEXT NULL REFERENCES training_plans (id) ON DELETE SET NULL, \"scheduled_date\" TEXT NOT NULL, \"completed_at\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"goal\" TEXT NOT NULL, \"duration_minutes\" INTEGER NOT NULL, \"exercise_count\" INTEGER NOT NULL, \"completed_outside_app\" INTEGER NOT NULL CHECK (\"completed_outside_app\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "workout_session_exercises",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"workout_session_exercises\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"session_id\" TEXT NOT NULL REFERENCES workout_sessions (id) ON DELETE CASCADE, \"position\" INTEGER NOT NULL, \"name\" TEXT NOT NULL, UNIQUE (\"session_id\", \"position\"));"
        }
      ]
    },
    {
      "name": "workout_set_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"workout_set_entries\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"session_id\" TEXT NOT NULL REFERENCES workout_sessions (id) ON DELETE CASCADE, \"exercise_position\" INTEGER NOT NULL, \"set_index\" INTEGER NOT NULL, \"repetitions\" INTEGER NULL, \"load_kg\" REAL NULL, \"duration_seconds\" INTEGER NULL, UNIQUE (\"session_id\", \"exercise_position\", \"set_index\"));"
        }
      ]
    },
    {
      "name": "scheduled_training_sessions",
      "sql": [
